#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#define DEFAULT 0
#define NUMROW 1
#define SYMBOLS 2


/ {
    keymap { 
        compatible = "zmk,keymap";

        default_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                                          |  Y   |  U    |  I    |  O   |   P   |   BSPC  |
// |  LGUI  |  A  |  S  |  D   |  F   |  G    |                                          |  H   |  J    |  K    |  L   |   +   |   TAB    |
// | LCTRL  |  Z  |  X  |  C   |  V   |  B    |  &mo 1 |   SPACE   |  |  &mo 2  |   ;   |   `   |  N    |  M    |  [   |   ]   |  ENTER  |
//                     |  -  | BSLH  | LALT  |  LSHFT  |   SPACE   |  |   &mo 2   |  ,  | RALT  | .  | / |
            bindings = <
    &kp ESC   &kp Q &kp W &kp E &kp R &kp T                                                &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
    &kp LGUI   &kp A &kp S &kp D &kp F &kp G                                                &kp H &kp J  &kp K     &kp L   &kp PLUS &kp TAB
    &kp LCTRL &kp Z &kp X &kp C &kp V &kp B &mo NUMROW &kp SPACE                 &mo SYMBOLS &kp SEMI &kp SQT &kp N  &kp M &kp LBKT &kp RBKT &kp ENTER
                   &kp MINUS &kp BSLH &kp LALT &kp LSHFT &kp SPACE         &mo SYMBOLS &kp COMMA &kp RALT &kp DOT &kp FSLH  >;
             sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
};
    numrow_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// | 1  |  2  |  3  |  4   |  5   |  6   |                                          |  7   |  8    |  9    |  0   |   -   |   BSPC  |
// |  LGUI  | USB | BLE | BT CLR | F | G |                                            | H | J | K | BT CLR | OUT TOGGLE | RGB |
// | LCTRL  |  Z  |  X  |  C   |  V   |  B    |  &mo 1 |   SPACE   |  |  &mo 2  |   ;   |   UP   |  N    |  M    |  [   |   ]   |  ENTER  |
//                     |  -  | BSLH  | LALT  |  LSHFT  |   SPACE   |  |  &mo 2   |  LEFT  | DOWN  | RIGHT  | / |
            bindings = <
   &kp N1   &kp N2 &kp N3 &kp N4 &kp N5 &kp N6                                                &kp N7 &kp N8  &kp N9     &kp N0   &kp MINUS    &kp BSPC
    &kp LGUI  &out OUT_USB &out OUT_BLE &bt BT_CLR &kp F &kp G                                      &kp H &kp J &kp K &bt BT_CLR     &out OUT_TOG    &rgb_ug RGB_COLOR_HSB(128, 100, 100)
    &kp LCTRL &kp Z &kp X &kp C &kp V &kp B &mo NUMROW &kp SPACE                  &mo SYMBOLS &kp UP &kp SQT &kp N  &kp M &kp LBKT &kp RBKT &kp ENTER
                     &kp MINUS &kp BSLH &kp LALT &kp LSHFT &kp SPACE        &mo SYMBOLS &kp LEFT  &kp DOWN &kp RIGHT &kp FSLH >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    symbols_layer {
// ---------------------------------------------------------------------------------------------------------------------------------
// |UNLOCK |  !  |  @  |  #   |  $   |  %   |                                          |  [   |  ]    |  {    |  }   |  PIPE |   BSPC  |
// |  LGUI |  `  | BSLH|  =   |  _   |  &   |                                          |  (   |  )    |  <    |  >   |   :   |   TAB   |
// | LCTRL |  ?  |  /  |  ;   | DQT  |  *   |  MO1   |   TAB     |  |  MO2    |  UP   |   '   | HOME  | END  | PGUP | PGDN |  ENTER  |
//                     |  -  | BSLH  | LALT  |  LSHFT  |   SPACE   |  |   MO2    | LEFT | DOWN | RIGHT | / |
            bindings = <
    &studio_unlock   &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)                        &kp LBKT &kp RBKT &kp LS(LBKT) &kp LS(RBKT) &kp LS(BSLH) &kp BSPC
    &kp LGUI  &kp GRAVE &kp BSLH &kp EQUAL &kp LS(MINUS) &kp LS(N7)                         &kp LS(N9) &kp LS(N0) &kp LS(COMMA) &kp LS(DOT) &kp LS(SEMI) &kp TAB
    &kp LCTRL &kp LS(FSLH) &kp FSLH &kp SEMI &kp LS(SQT) &kp LS(N8) &mo NUMROW &kp TAB      &mo SYMBOLS &kp UP &kp SQT &kp HOME &kp END &kp PG_UP &kp PG_DN &kp ENTER
                   &kp MINUS &kp BSLH &kp LALT &kp LSHFT &kp SPACE         &mo SYMBOLS &kp LEFT &kp DOWN &kp RIGHT &kp FSLH >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
